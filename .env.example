# untisbot -- Beispielkonfiguration
#
# Kopieren und ausfuellen:
#   cp .env.example .env
#
# .env wird von config.py geladen und steht in .gitignore -- landet also
# nie im Repo. Fuer GitHub Actions werden dieselben Werte stattdessen als
# Repository-Secrets hinterlegt (Settings -> Secrets and variables -> Actions).

# --- Telegram -----------------------------------------------------------
# Token von @BotFather (Kommando /newbot).
TELEGRAM_BOT_TOKEN=123456789:AAH-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat-ID(s), die benachrichtigt werden sollen. Mehrere durch Komma trennen.
# Erst dem Bot in Telegram /start schreiben, dann ermitteln mit:
#   python -m untisbot.get_chat_id
TELEGRAM_CHAT_ID=

# --- WebUntis -------------------------------------------------------------
# Server-Hostname ohne https://, z. B. "achilles.webuntis.com".
WEBUNTIS_SERVER=
# Schulkuerzel, wie es WebUntis in der URL/Login-Maske verwendet.
WEBUNTIS_SCHOOL=
WEBUNTIS_USERNAME=
WEBUNTIS_PASSWORD=

# Optional. Nur noetig, wenn der Account keinen persoenlichen Stundenplan
# hat und stattdessen ein Klassenplan abgerufen werden muss (z. B. "10a").
WEBUNTIS_KLASSE=

# --- Verhalten (optional, Standardwerte siehe config.py) ------------------
LOOKAHEAD_DAYS=7
TIMEZONE=Europe/Berlin
LOG_LEVEL=INFO
